# Server Environment
NODE_ENV=production

# GOOGLE MAPS API KEY: Required for interactive Google Maps and Geocoding.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
VITE_APP_URL=

# JWT_SECRET: Secret key for signing authentication tokens (min 32 characters recommended).
JWT_SECRET=

# ADMIN_SECRET_KEY: Secret key required for Administrative operations and dashboard access.
ADMIN_SECRET_KEY=

# TRUST_PROXY: Reverse proxy trust level for Cloud Run / load balancers (e.g. 1).
TRUST_PROXY=1

# GOOGLE_CLIENT_ID: Required for client-side and server-side Google authentication.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=


